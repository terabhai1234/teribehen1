-- Create Database
CREATE DATABASE CompanyDB;

-- Use Database
USE CompanyDB;

-- Create Employee Table
CREATE TABLE Employee (
    emp_id INT PRIMARY KEY,
    emp_name VARCHAR(50),
    department VARCHAR(50),
    salary INT
);

-- Insert Data
INSERT INTO Employee VALUES
(1, 'Rahul', 'IT', 50000),
(2, 'Anita', 'HR', 40000),
(3, 'Aman', 'IT', 60000),
(4, 'Priya', 'Finance', 45000),
(5, 'Rohan', 'HR', 42000);

-- Display Table
SELECT * FROM Employee;

-- =====================================
-- NESTED QUERIES
-- =====================================

-- Employees having salary greater than average salary
SELECT emp_name, salary
FROM Employee
WHERE salary > (
    SELECT AVG(salary)
    FROM Employee
);

-- Employees working in same department as Rahul
SELECT emp_name, department
FROM Employee
WHERE department = (
    SELECT department
    FROM Employee
    WHERE emp_name = 'Rahul'
);

-- Employee having maximum salary
SELECT emp_name, salary
FROM Employee
WHERE salary = (
    SELECT MAX(salary)
    FROM Employee
);

-- Employees from HR department using nested query
SELECT emp_name
FROM Employee
WHERE department = (
    SELECT department
    FROM Employee
    WHERE emp_name = 'Anita'
);
