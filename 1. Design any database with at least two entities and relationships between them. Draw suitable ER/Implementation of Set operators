-- Create Database
CREATE DATABASE CollegeDB;

-- Use Database
USE CollegeDB;

-- Create Science Table
CREATE TABLE Science (
    student_id INT,
    student_name VARCHAR(50)
);

-- Create Commerce Table
CREATE TABLE Commerce (
    student_id INT,
    student_name VARCHAR(50)
);

-- Insert Data into Science
INSERT INTO Science VALUES
(1, 'Rahul'),
(2, 'Anita'),
(3, 'Aman');

-- Insert Data into Commerce
INSERT INTO Commerce VALUES
(2, 'Anita'),
(3, 'Aman'),
(4, 'Priya');

-- Display Tables
SELECT * FROM Science;
SELECT * FROM Commerce;

-- =====================================
-- SET OPERATORS
-- =====================================

-- UNION Operator
SELECT * FROM Science
UNION
SELECT * FROM Commerce;

-- UNION ALL Operator
SELECT * FROM Science
UNION ALL
SELECT * FROM Commerce;

-- INTERSECT Operator
SELECT * FROM Science
INTERSECT
SELECT * FROM Commerce;

-- EXCEPT / MINUS Operator
SELECT * FROM Science
EXCEPT
SELECT * FROM Commerce;
