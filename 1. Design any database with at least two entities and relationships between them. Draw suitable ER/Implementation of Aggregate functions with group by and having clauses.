-- Create Database
CREATE DATABASE CompanyDB;

-- Use Database
USE CompanyDB;

-- Create Employee Table
CREATE TABLE Employee (
    emp_id INT PRIMARY KEY,
    emp_name VARCHAR(50),
    department VARCHAR(50),
    salary INT
);

-- Insert Data
INSERT INTO Employee VALUES
(1, 'Rahul', 'IT', 50000),
(2, 'Anita', 'HR', 40000),
(3, 'Aman', 'IT', 60000),
(4, 'Priya', 'Finance', 45000),
(5, 'Rohan', 'HR', 42000);

-- Display Table
SELECT * FROM Employee;

-- =====================================
-- AGGREGATE FUNCTIONS
-- =====================================

-- COUNT Function
SELECT department, COUNT(*) AS total_employees
FROM Employee
GROUP BY department;

-- SUM Function
SELECT department, SUM(salary) AS total_salary
FROM Employee
GROUP BY department;

-- AVG Function
SELECT department, AVG(salary) AS average_salary
FROM Employee
GROUP BY department;

-- MAX Function
SELECT department, MAX(salary) AS highest_salary
FROM Employee
GROUP BY department;

-- MIN Function
SELECT department, MIN(salary) AS lowest_salary
FROM Employee
GROUP BY department;

-- HAVING Clause
SELECT department, AVG(salary) AS average_salary
FROM Employee
GROUP BY department
HAVING AVG(salary) > 45000;
