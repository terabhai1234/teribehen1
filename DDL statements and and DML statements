-- Join query
SELECT 
    e.enroll_id,
    s.student_name,
    c.course_name,
    e.enroll_date
FROM Enrollment e
JOIN Student s ON e.student_id = s.student_id
JOIN Course c ON e.course_id = c.course_id;
